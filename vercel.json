{
  "framework": "vite",
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/veranstaltung/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Applebot|SkypeUriPreview|Signal).*"
        }
      ],
      "destination": "/api/events/:slug?og=1"
    },
    {
      "source": "/((?!api/|@vite|@react-refresh|src/|node_modules/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/events?cleanup=1",
      "schedule": "0 3 * * *"
    }
  ]
}
