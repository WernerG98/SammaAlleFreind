generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?
  imageUrl       String?
  eventDate      DateTime?
  eventEndDate   DateTime? // nur fuer den Kalender-Export, wird sonst nirgends angezeigt
  comingSoon     Boolean  @default(false)
  collectInterest Boolean @default(false)
  registrationDeadline DateTime?
  pricePerPerson Decimal? @db.Decimal(10, 2)
  paypalLink     String?
  paymentNote    String?
  iban           String?
  bic            String?
  accountHolder  String?
  isOpen         Boolean  @default(true)
  noRegistrationRequired Boolean @default(false)
  isExternal          Boolean @default(false)
  externalOrganizer   String?
  externalContactEmail String?
  earlyAccessEnabled  Boolean @default(false)
  earlyAccessPassword String?
  isPrivate           Boolean @default(false)
  privatePassword     String?
  commentsEnabled     Boolean @default(false)
  createdAt      DateTime @default(now())

  buses         Bus[]
  registrations Registration[]
  interests     EventInterest[]
  seatReleases  SeatRelease[]
}

model Bus {
  id       String  @id @default(cuid())
  eventId  String
  name     String
  capacity Int?
  enabled  Boolean @default(true)

  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
  interests     EventInterest[]
}

model Registration {
  id              String    @id @default(cuid())
  eventId         String
  busId           String
  groupId         String?
  firstName       String
  lastName        String
  email           String
  newsletterOptIn Boolean   @default(false)
  comment         String?
  paid            Boolean   @default(false)
  paidAt          DateTime?
  cancelToken     String?   @unique
  createdAt       DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bus   Bus   @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([eventId, email])
  @@index([groupId])
}

model EventInterest {
  id        String   @id @default(cuid())
  eventId   String
  busId     String?
  firstName String
  lastName  String
  email     String
  createdAt DateTime @default(now())

  // Automatisches Nachrücken: null = noch nicht angeboten, "pending" = Mail verschickt,
  // "declined" = "Nein danke", "expired" = 24 h keine Reaktion.
  offerStatus String?
  offeredAt   DateTime?
  offerToken  String?   @unique

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bus   Bus?  @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
}

// Ein frei gewordener Platz (eine Zeile pro storniertem/entferntem Platz). Nach 60 Minuten
// wird er der Reihe nach der Warteliste angeboten, bis er wieder belegt ist.
model SeatRelease {
  id                String    @id @default(cuid())
  eventId           String
  busId             String
  releasedAt        DateTime  @default(now())
  offeredInterestId String?
  closedAt          DateTime?
  closedReason      String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([closedAt, releasedAt])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}
