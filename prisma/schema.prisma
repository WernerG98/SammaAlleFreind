generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  description    String?
  imageUrl       String?
  eventDate      DateTime?
  comingSoon     Boolean  @default(false)
  registrationDeadline DateTime?
  pricePerPerson Decimal? @db.Decimal(10, 2)
  paypalLink     String?
  paymentNote    String?
  isOpen         Boolean  @default(true)
  noRegistrationRequired Boolean @default(false)
  isExternal          Boolean @default(false)
  externalOrganizer   String?
  externalContactEmail String?
  earlyAccessEnabled  Boolean @default(false)
  earlyAccessPassword String?
  isPrivate           Boolean @default(false)
  privatePassword     String?
  commentsEnabled     Boolean @default(false)
  createdAt      DateTime @default(now())

  buses         Bus[]
  registrations Registration[]
  interests     EventInterest[]
}

model Bus {
  id       String  @id @default(cuid())
  eventId  String
  name     String
  capacity Int?
  enabled  Boolean @default(true)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
}

model Registration {
  id              String    @id @default(cuid())
  eventId         String
  busId           String
  firstName       String
  lastName        String
  email           String
  newsletterOptIn Boolean   @default(false)
  comment         String?
  paid            Boolean   @default(false)
  paidAt          DateTime?
  cancelToken     String?   @unique
  createdAt       DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bus   Bus   @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
}

model EventInterest {
  id        String   @id @default(cuid())
  eventId   String
  firstName String
  lastName  String
  email     String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
