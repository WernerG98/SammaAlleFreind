# Postgres-Verbindung (z.B. von Neon: https://neon.tech, "pooled connection string" verwenden)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Resend (https://resend.com) - API-Key und verifizierte Absenderadresse
RESEND_API_KEY=""
FROM_EMAIL="Vereins-Events <events@deine-domain.de>"

# Antworten von Gästen landen in diesem Postfach (kein eigenes Postfach an der neuen Domain nötig)
REPLY_TO_EMAIL="deine-bestehende-adresse@example.com"

# Admin-Zugangsdaten (Hash mit `npm run seed:admin -- <passwort>` erzeugen)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Zufälliger, langer geheimer String zum Signieren der Admin-Session (z.B. mit `openssl rand -hex 32` erzeugen)
SESSION_SECRET=""

# Basis-URL der Seite, wird für Links in E-Mails (Zahlungsseite, Abmelde-Link) verwendet
PUBLIC_BASE_URL="http://localhost:3000"
